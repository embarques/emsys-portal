# Copy to .env.local for personal overrides (optional).
#
#   cp .env.local.example .env.local
#
# Do NOT set NEXT_PUBLIC_API_BASE_URL here — remote URL comes from `.env`.
# For local API only, run: npm run dev:local

# Auth mode for local work
NEXT_PUBLIC_BYPASS_AUTH=true

# Dev session (when NEXT_PUBLIC_BYPASS_AUTH=true)
NEXT_PUBLIC_DEV_COMPANY_ID=
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=
NEXT_PUBLIC_DEV_NAME=

# Optional: paste a token instead of email/password auto-login
NEXT_PUBLIC_DEV_ID_TOKEN=

# Routes + active routes use the EMSYS API by default.
# Set to true to use the local browser store instead (empty start, persists in localStorage).
# NEXT_PUBLIC_ROUTES_USE_MOCK=true

# Firebase (when NEXT_PUBLIC_BYPASS_AUTH=false)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Playwright Firebase test account (never commit real credentials)
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_TEST_COMPANY_ID=

# Optional: pin branch for daily-income tests (omit to run on every branch).
# PLAYWRIGHT_DAILY_INCOME_BRANCH=NY
